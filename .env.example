# ============================================
# FaturasAI - Variaveis de Ambiente
# ============================================
# Copiar para .env e preencher com os valores reais.
# NUNCA fazer commit do .env!

# --- SUPABASE ---
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- GOOGLE ---
# Apenas o CLIENT_ID no frontend (CLIENT_SECRET fica nas Edge Functions)
VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# --- POSTHOG (analytics) ---
# Opcional: se ausente, analytics fica desativado sem erro.
# Nomes recomendados pelo PostHog (aceita também os antigos VITE_POSTHOG_KEY / VITE_POSTHOG_HOST)
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
